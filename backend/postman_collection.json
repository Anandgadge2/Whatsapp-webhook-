{
  "info": {
    "name": "WhatsApp Bot API Collection",
    "_postman_id": "whatsapp-bot-collection",
    "description": "APIs for testing WhatsApp webhook bot",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Officer",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Officer A\",\n  \"whatsappNumber\": \"919876543210\",\n  \"sites\": [7720,7202]\n}"
        },
        "url": {
          "raw": "http://localhost:4000/api/officers",
          "protocol": "http",
          "host": ["localhost"],
          "port": "4000",
          "path": ["api", "officers"]
        }
      }
    },
    {
      "name": "Report Incident",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"citizenNumber\": \"919812345678\",\n  \"lat\": 21.11085,\n  \"lng\": 79.06281,\n  \"photoUrl\": \"https://example.com/test.jpg\",\n  \"description\": \"Forest fire near office\"\n}"
        },
        "url": {
          "raw": "http://localhost:4000/api/incidents/report",
          "protocol": "http",
          "host": ["localhost"],
          "port": "4000",
          "path": ["api", "incidents", "report"]
        }
      }
    },
    {
      "name": "Update Status",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{ \"status\": \"completed\" }"
        },
        "url": {
          "raw": "http://localhost:4000/api/incidents/INCIDENT_ID/status",
          "protocol": "http",
          "host": ["localhost"],
          "port": "4000",
          "path": ["api", "incidents", "INCIDENT_ID", "status"]
        }
      }
    }
  ]
}
