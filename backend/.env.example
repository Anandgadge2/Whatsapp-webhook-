# Environment Variables Template
# Copy this file to .env and fill in your actual values

# ==============================================
# SERVER CONFIGURATION
# ==============================================
PORT=3000
NODE_ENV=development

# ==============================================
# WHATSAPP CLOUD API (META)
# ==============================================

# Get these from: https://developers.facebook.com/apps/
# Navigate to: Your App > WhatsApp > Getting Started

# Temporary token (expires in 24 hours) - for development only
# For production, generate a permanent token from System Users
GRAPH_API_TOKEN=your_access_token_here

# Phone Number ID - found in WhatsApp > Getting Started
PHONE_NUMBER_ID=your_phone_number_id_here

# Create your own secure random string for webhook verification
# Example: openssl rand -base64 32
WEBHOOK_VERIFY_TOKEN=your_secure_random_string_here

# Optional: Business Account ID (for analytics)
BUSINESS_ACCOUNT_ID=your_business_account_id_here

# ==============================================
# DATABASE
# ==============================================

# Local MongoDB (Development)
# MONGODB_URI=mongodb://127.0.0.1:27017/whatsapp_bot

# MongoDB Atlas (Production)
# Get from: https://cloud.mongodb.com
# Format: mongodb+srv://username:password@cluster.mongodb.net/database_name
MONGODB_URI=your_mongodb_connection_string_here

# ==============================================
# CLOUDINARY (MEDIA STORAGE)
# ==============================================

# Get these from: https://cloudinary.com/console
# Dashboard > Account Details

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==============================================
# SECURITY (OPTIONAL - RECOMMENDED FOR PRODUCTION)
# ==============================================

# JWT Secret for admin authentication
# Generate: openssl rand -base64 64
# JWT_SECRET=your_jwt_secret_here

# Admin credentials (if implementing admin panel)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=your_secure_password

# ==============================================
# RATE LIMITING (OPTIONAL)
# ==============================================

# Maximum requests per window
# RATE_LIMIT_MAX=100

# Time window in milliseconds (15 minutes = 900000)
# RATE_LIMIT_WINDOW_MS=900000

# ==============================================
# CORS (OPTIONAL)
# ==============================================

# Allowed origins for CORS (comma-separated)
# CORS_ORIGIN=https://yourdomain.com,https://admin.yourdomain.com

# ==============================================
# LOGGING (OPTIONAL)
# ==============================================

# Log level: error, warn, info, debug
# LOG_LEVEL=info

# ==============================================
# EXTERNAL SERVICES (OPTIONAL)
# ==============================================

# Sentry (Error Tracking)
# Get from: https://sentry.io
# SENTRY_DSN=your_sentry_dsn_here

# SendGrid (Email Notifications)
# Get from: https://sendgrid.com
# SENDGRID_API_KEY=your_sendgrid_key_here
# SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Twilio (SMS Notifications - Optional)
# Get from: https://www.twilio.com
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=your_twilio_number

# ==============================================
# FEATURE FLAGS (OPTIONAL)
# ==============================================

# Enable/disable features
# ENABLE_WEBSOCKET=true
# ENABLE_ADMIN_PANEL=true
# ENABLE_ANALYTICS=true

# ==============================================
# NOTES
# ==============================================

# 1. NEVER commit this file to version control
# 2. Keep a backup of production .env in a secure location
# 3. Use different values for development and production
# 4. Rotate tokens regularly for security
# 5. Use strong, unique passwords and secrets
# 6. For production, use environment variables from your hosting platform
